{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/definition.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/definition",
      "destination": "/api/definition"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
